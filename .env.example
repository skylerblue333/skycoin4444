# Application runtime
NODE_ENV=development
PORT=3000
VITE_APP_ID=

# Authentication and authorization — server-only values
# Generate a high-entropy value for JWT_SECRET. Never commit an actual secret.
JWT_SECRET=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
WEBHOOK_SECRET=

# Database — server-only value
# Example: mysql://USER:PASSWORD@HOST:3306/DATABASE
DATABASE_URL=

# Built-in service proxy configuration — server-only values
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Browser OAuth configuration — public identifiers/URLs only
VITE_OAUTH_PORTAL_URL=

# Browser map configuration — use only a domain-restricted public browser key.
# Do not use a database, OAuth, storage, LLM, or other server credential here.
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=
