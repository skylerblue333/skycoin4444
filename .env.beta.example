# SKYCOIN4444 invitation-only engineering beta.
# Copy values into the deployment provider's secret/environment manager.
# Do not commit real credentials or provider secrets.

NODE_ENV=production
LOCAL_TEST_MODE=false
BETA_ACCESS_MODE=invite_only

# Dedicated remote MySQL beta database. localhost is rejected in production.
DATABASE_URL=mysql://USER:PASSWORD@MYSQL_HOST:3306/skycoin4444_beta

# At least 32 bytes. Generate and store only in the deployment secret manager.
JWT_SECRET=REPLACE_WITH_32_BYTE_OR_LONGER_SECRET

# Verified OAuth configuration.
VITE_APP_ID=REPLACE_WITH_BETA_APP_ID
OAUTH_SERVER_URL=https://REPLACE_WITH_OAUTH_SERVER
VITE_OAUTH_PORTAL_URL=https://REPLACE_WITH_OAUTH_PORTAL

# Exact deployed HTTPS origin; no path or query.
BETA_PUBLIC_ORIGIN=https://REPLACE_WITH_BETA_HOST

# At least one invitation source is required in production.
OWNER_OPEN_ID=
BETA_ALLOWED_EMAILS=
BETA_ALLOWED_OPEN_IDS=

# Optional/unverified providers stay empty unless separately approved.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Optional bounded runtime guardrails.
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=15000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
HTTP_MAX_REQUESTS_PER_SOCKET=1000
MAX_IN_FLIGHT_REQUESTS=128
SHUTDOWN_GRACE_MS=10000

# Optional internal durable outbox dispatcher.
# Disabled by default. This processes events only through the local
# platform-event-observer; it does not configure an external broker.
EVENT_OUTBOX_DISPATCHER_ENABLED=false
EVENT_OUTBOX_POLL_MS=1000
EVENT_OUTBOX_BATCH_SIZE=25
EVENT_OUTBOX_LEASE_MS=15000
EVENT_OUTBOX_MAX_ATTEMPTS=8
EVENT_OUTBOX_BASE_DELAY_MS=500
EVENT_OUTBOX_MAX_DELAY_MS=60000
